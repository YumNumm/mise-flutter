#!/usr/bin/env bash

get_jq_filename() {
  case "$(uname -s)" in
  Linux)
    case "$(uname -m)" in
    x86_64) echo jq-linux-amd64 ;;
    esac ;;
  Darwin)
    case "$(uname -m)" in
    x86_64) echo jq-macos-amd64 ;;
    arm64) echo jq-macos-arm64 ;;
    esac ;;
  esac
}

download_jq_if_not_exists() {

  local jq_path="${currentDir}/jq" candidate
  # A mise/asdf shim can resolve Flutter again while listing its aliases,
  # recursively invoking this plugin. Select an executable outside shims.
  while IFS= read -r candidate; do
    case "${candidate}" in
      */shims/jq | shims/jq) continue ;;
    esac
    jq_path="${candidate}"
    break
  done < <(type -aP jq || true)

  if [[ ! -x "${jq_path}" ]]; then
    curl -sL "https://github.com/jqlang/jq/releases/latest/download/$(get_jq_filename)" -o "${jq_path}"
    chmod +x "${jq_path}"
  fi

  export JQ_BIN="${jq_path}"
}
